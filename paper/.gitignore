# LaTeX build outputs — rebuild with: tectonic main.tex (or latexmk -pdf)
# NOTE: arXiv submission NEEDS main.bbl — generate it (tectonic --keep-intermediates
# or bibtex) at submission time even though it's ignored here.
main.pdf
*.aux
*.bbl
*.blg
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.xdv
*.err
terr

# Regenerable figure data (large): raw fields + STL. Rebuild with:
#   dart run tools/paper_figs.dart
# The rendered PNGs in figures/ ARE committed (needed to build the paper).
figures/data/
